- const pageTitle = page.title ? `${page.title} · ${theme.SEO_title || config.title}` : (theme.SEO_title || config.title)
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  meta(name='author' content=config.author)
  meta(name='description' content=config.description)
  title= pageTitle
  link(rel='canonical' href=full_url_for(page.path || ''))
  each url in theme.stylesheets
    link(rel='stylesheet' href=url_for(url))
  link(rel='icon' href=url_for(theme.favicon))
  link(rel='stylesheet' href=url_for('/vendor/font-awesome/css/font-awesome.min.css'))
  each url in theme.scripts
    script(src=url_for(url) defer)
